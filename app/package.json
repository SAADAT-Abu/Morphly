{
  "name": "morphly",
  "productName": "Morphly",
  "version": "0.3.0",
  "description": "A free, offline scientific figure editor built on the NIH BioArt Source library",
  "author": "Abu Saadat",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "konva": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.abusaadat.morphly",
    "productName": "Morphly",
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "build/icon.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bioart_library",
        "to": "libraries/bioart_library",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "build/icon.png",
      "synopsis": "Scientific figure editor",
      "description": "Build scientific figures from openly licensed illustration libraries.",
      "syncDesktopName": true,
      "executableName": "morphly"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "desktopName": "morphly.desktop",
  "homepage": "https://github.com/SAADAT-Abu/Morphly",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAADAT-Abu/Morphly.git"
  }
}
